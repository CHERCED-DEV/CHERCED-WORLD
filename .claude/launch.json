{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-sin-gemini",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.GEMINI_API_KEY=' ';require('child_process').spawn('npm',['run','dev'],{stdio:'inherit',shell:true}).on('exit',(code)=>process.exit(code??0))"
      ],
      "port": 3000
    },
    {
      "name": "prod-check",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3199"
      ],
      "port": 3199
    }
  ]
}
