{
  "description": "After a recipe is written or edited, checks that it lists its allergens.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-allergens.mjs\""
          }
        ]
      }
    ]
  }
}
